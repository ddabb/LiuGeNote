#!/bin/sh
# 行数护栏：新增/修改文件 <=900 行；白名单 scripts/size_whitelist.json 只减不增。
# 查看行数榜/重置白名单：py -3 scripts/code_stats.py --top 20 / --init-whitelist
py -3 scripts/code_stats.py --check
if [ $? -ne 0 ]; then
  echo ""
  echo "[pre-commit] 行数护栏未通过，提交被拒绝。"
  echo "  - 超标新文件请拆分（目标 <=900 行）；"
  echo "  - 白名单文件不得超过登记上限（scripts/size_whitelist.json，只减不增）。"
  exit 1
fi
